# Global deployment configuration
APP_NAME=hsf-kiosk

# Target directories
BACKEND_DIR=/opt/${APP_NAME}
FRONTEND_DIR=/srv/${APP_NAME}
FILES_DIR=/mnt/${APP_NAME}-files
NGINXCONF_DIR=/etc/nginx/conf.d

# Networking
NGINX_PORT=80
NODE_PORT=3000
SERVER_NAME=your-domain.com

# Public MagicMirror URL embedded in the frontend bundle
SCREENSAVER_UPSTREAM=https://magicmirror.example.com/

# Backend runtime configuration
# FILES_DIR=/mnt/${APP_NAME}-files
# CALENDAR_EVENTS=https://example.com/calendar.ics
# ZAMMAD_API_URL=https://example.com/api/v1
# ZAMMAD_API_TOKEN=
